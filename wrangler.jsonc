{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiffane",
  "main": "src/index.js",
  "compatibility_date": "2024-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "kiffane.com",
          "zone_name": "kiffane.com"
        }
      ]
    }
  },
  "vars": {
    "RESEND_API_KEY": "PLACEHOLDER"
  }
}
